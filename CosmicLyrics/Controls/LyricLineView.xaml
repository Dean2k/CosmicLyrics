<UserControl x:Class="CosmicLyrics.Controls.LyricLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Storyboard x:Key="ActivateAnimation">
            <DoubleAnimation Storyboard.TargetName="LineContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="5" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainText"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="RomanizedTextBlock"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.85" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="GlowRect"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
        </Storyboard>

        <Storyboard x:Key="DeactivateAnimation">
            <DoubleAnimation Storyboard.TargetName="MainText"
                             Storyboard.TargetProperty="Opacity"
                             To="0.28" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="RomanizedTextBlock"
                             Storyboard.TargetProperty="Opacity"
                             To="0.28" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="GlowRect"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="0,3">
        <!-- Glow bar behind active line -->
        <Rectangle x:Name="GlowRect" Opacity="0" RadiusX="6" RadiusY="6" Margin="-20,0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00004466" Offset="0"/>
                    <GradientStop Color="#2800AACC" Offset="0.25"/>
                    <GradientStop Color="#2800AACC" Offset="0.75"/>
                    <GradientStop Color="#00004466" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border x:Name="LineContainer" Padding="16,7" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
            <StackPanel>
                <TextBlock x:Name="MainText"
                           Text="{Binding Text, ElementName=Root}"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="18"
                           Opacity="0.28"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="RomanizedTextBlock"
                           Text="{Binding RomanizedText, ElementName=Root}"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Opacity="0.28"
                           Foreground="#88AACC"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRomanized, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


