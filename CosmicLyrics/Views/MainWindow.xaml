<Window x:Class="CosmicLyrics.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:CosmicLyrics.Controls"
        xmlns:vm="clr-namespace:CosmicLyrics.ViewModels"
        Title="Cosmic Lyrics"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#080612"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Lyric item template -->
        <DataTemplate x:Key="LyricItemTemplate">
            <controls:LyricLineView Text="{Binding Text}"
                                    IsActive="{Binding IsActive}"
                                    HorizontalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Cosmic animated background -->
        <controls:CosmicCanvas x:Name="CosmicBg"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>

        <!-- Dark vignette overlay -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="Transparent" Offset="0.3"/>
                    <GradientStop Color="#AA080612" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Main layout: TitleBar | Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- Custom title bar -->
                <RowDefinition Height="*"/>   <!-- Content -->
            </Grid.RowDefinitions>

            <!-- === TITLE BAR === -->
            <Grid Grid.Row="0" Background="#0D0B1E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <!-- Logo icon -->
                    <Ellipse Width="20" Height="20" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00CCFF" Offset="0"/>
                                <GradientStop Color="#0044AA" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="COSMIC  LYRICS"
                               FontSize="13"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="#88AACCFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VideoTitle}"
                               FontSize="12"
                               Foreground="#446688AA"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0"
                               MaxWidth="500"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="46" Height="40"
                            Style="{StaticResource CosmicButton}"
                            BorderThickness="0" Background="Transparent"
                            FontSize="16" Foreground="#88AACCFF"
                            Click="MinimizeWindow_Click"/>
                    <Button Content="□" Width="46" Height="40"
                            Style="{StaticResource CosmicButton}"
                            BorderThickness="0" Background="Transparent"
                            FontSize="16" Foreground="#88AACCFF"
                            Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Width="46" Height="40"
                            Style="{StaticResource CosmicButton}"
                            BorderThickness="0" Background="Transparent"
                            FontSize="16" Foreground="#88AACCFF"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>

            <!-- === MAIN CONTENT === -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="300"/>
                    <ColumnDefinition Width="4"/>   <!-- Splitter -->
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: Controls + YouTube -->
                <Grid Grid.Column="0" Background="#0A0818">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Search -->
                        <RowDefinition Height="*"/>      <!-- YouTube player -->
                        <RowDefinition Height="Auto"/>   <!-- Lyrics search -->
                        <RowDefinition Height="Auto"/>   <!-- Status -->
                    </Grid.RowDefinitions>

                    <!-- URL Input -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="#1A1A44" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Y O U T U B E" FontSize="10" FontWeight="Bold"
                                       Foreground="#33446688" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="UrlInput"
                                         Style="{StaticResource CosmicTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="UrlInput_KeyDown"
                                         Tag="Paste YouTube URL or search..."
                                         FontSize="13"/>
                                <Button Grid.Column="2"
                                        Content="Load"
                                        Style="{StaticResource CosmicButtonAccent}"
                                        Click="LoadUrl_Click"
                                        Padding="12,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- WebView2 YouTube Player -->
                    <Border Grid.Row="1" Margin="0">
                        <Grid Background="#06050F">
                            <!-- Placeholder when no video -->
                            <StackPanel x:Name="VideoPlaceholder"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Ellipse Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#0044AA" Offset="0"/>
                                            <GradientStop Color="#001133" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="▶" FontSize="24" Foreground="#22446688"
                                           HorizontalAlignment="Center" Margin="0,-44,0,44"/>
                                <TextBlock Text="Paste a YouTube URL above" Foreground="#224466AA"
                                           FontSize="13" TextAlignment="Center"/>
                            </StackPanel>

                            <wv2:WebView2 x:Name="YoutubePlayer"
                                          Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Lyrics Search -->
                    <Border Grid.Row="2" Padding="12,10" BorderBrush="#1A1A44" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="L Y R I C S" FontSize="10" FontWeight="Bold"
                                       Foreground="#33446688" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource CosmicTextBox}"
                                         Text="{Binding ArtistInput, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Artist"
                                         FontSize="12"
                                         KeyDown="LyricsSearch_KeyDown"/>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource CosmicTextBox}"
                                         Text="{Binding TrackInput, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Track / Song"
                                         FontSize="12"
                                         KeyDown="LyricsSearch_KeyDown"/>
                                <Button Grid.Column="4"
                                        Content="Find"
                                        Style="{StaticResource CosmicButton}"
                                        Click="FetchLyrics_Click"
                                        Padding="12,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" Padding="12,6" Background="#08080F">
                        <Grid>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="#446688AA"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <!-- Loading spinner (visible when loading) -->
                            <Border x:Name="LoadingSpinner"
                                    Width="14" Height="14"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsLoadingLyrics, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Width="12" Height="12"
                                         Stroke="#00AACC" StrokeThickness="2"
                                         StrokeDashArray="2,4">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="6" CenterY="6"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              Background="#1A1A44"
                              Cursor="SizeWE"/>

                <!-- RIGHT PANEL: Cosmic Lyric Display -->
                <Grid Grid.Column="2">
                    <!-- The actual lyrics panel -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Lyrics ScrollViewer -->
                        <ScrollViewer Grid.Row="0"
                                      x:Name="LyricsScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalFirst">

                            <ItemsControl x:Name="LyricsPanel"
                                          ItemsSource="{Binding DisplayedLyrics}"
                                          ItemTemplate="{StaticResource LyricItemTemplate}"
                                          HorizontalAlignment="Center"
                                          Width="560"
                                          Padding="0,280,0,280">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <Border Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ItemsControl.Template>

                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Center highlight overlay (lines above/below the active are dimmed) -->
                        <Grid IsHitTestVisible="False" Grid.Row="0">
                            <!-- Top fade -->
                            <Border VerticalAlignment="Top" Height="200">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EE080612" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Bottom fade -->
                            <Border VerticalAlignment="Bottom" Height="200">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#EE080612" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Bottom controls bar -->
                        <Border Grid.Row="1" Padding="12,8" Background="#0A0818"
                                BorderBrush="#1A1A44" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- sync dot -->
                                    <ColumnDefinition Width="*"/>     <!-- offset -->
                                    <ColumnDefinition Width="Auto"/>  <!-- auto-scroll -->
                                </Grid.ColumnDefinitions>

                                <!-- Sync indicator -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#444466"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                        <Setter Property="Fill" Value="#00FF88"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#446688AA">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="No lyrics"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                        <Setter Property="Text" Value="Synced"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Offset control -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="OFFSET" FontSize="9" FontWeight="Bold"
                                               Foreground="#33446688" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="−" Width="24" Height="22"
                                            Style="{StaticResource CosmicButton}"
                                            FontSize="14" Padding="0"
                                            Click="OffsetMinus_Click"/>
                                    <TextBlock Text="{Binding LyricOffsetText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#88AACCFF"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               MinWidth="46"
                                               Margin="6,0"/>
                                    <Button Content="+" Width="24" Height="22"
                                            Style="{StaticResource CosmicButton}"
                                            FontSize="13" Padding="0"
                                            Click="OffsetPlus_Click"/>
                                    <Button Content="↺" Width="24" Height="22"
                                            Style="{StaticResource CosmicButton}"
                                            FontSize="13" Padding="0"
                                            Margin="4,0,0,0"
                                            ToolTip="Reset offset to 0"
                                            Click="OffsetReset_Click"/>
                                </StackPanel>

                                <!-- Auto-scroll toggle -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-scroll" FontSize="11" Foreground="#446688AA"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <CheckBox IsChecked="{Binding AutoScrollEnabled}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyLyricsState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasLyrics, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="✦" FontSize="48" Foreground="#11224466"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="C O S M I C  L Y R I C S" FontSize="14" FontWeight="Bold"
                                   Foreground="#22446688"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Load a YouTube video to begin" FontSize="12"
                                   Foreground="#15336655" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Resize grip -->
        <ResizeGrip VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Width="16" Height="16" Opacity="0.3"/>
    </Grid>

</Window>
